{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Magma",
  "version": "0.1.1",
  "identifier": "com.magma.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Magma",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRGQjE0MUY1QTRGREFEMkUKUldRdXJmMms5VUd4VHhxcC9FTTQrajVYaDJVaXl4ZXFRcnRUQklnTXFLbm4xU0ZEdVRwQVF5V1UK",
      "endpoints": [
        "https://github.com/7H3-CH053N/Magma/releases/latest/download/latest.json"
      ]
    }
  }
}
